// Enhanced Socket.IO server for real-time video consultation signaling
const { createServer } = require('http');
const { parse } = require('url');
const next = require('next');
const { Server } = require('socket.io');

const dev = process.env.NODE_ENV !== 'prod        console.log(`🚀 Aarogya Sahayak server ready on http://${hostname}:${port}`);
        console.log(`📹 Video consultation server initialized`);
        console.log(`🏥 Telemedicine features activated`);
        console.log(`💻 Environment: ${dev ? 'development' : 'production'}`);on';
const hostname = 'localhost';
const port = process.env.PORT || 3001;

// Create Next.js app instance
const app = next({ dev, hostname, port });
const handle = app.getRequestHandler();

// Room management for video consultations
const rooms = new Map();
const participants = new Map();

// Helper function to log with timestamp
const log = (message, data = null) => {
    const timestamp = new Date().toISOString();
    console.log(`[${timestamp}] Aarogya Sahayak: ${message}`, data ? JSON.stringify(data, null, 2) : '');
};

app.prepare().then(() => {
    const server = createServer(async (req, res) => {
        try {
            const parsedUrl = parse(req.url, true);
            await handle(req, res, parsedUrl);
        } catch (err) {
            console.error('Error occurred handling', req.url, err);
            res.statusCode = 500;
            res.end('internal server error');
        }
    });

    // Initialize Socket.IO server with CORS configuration
    const io = new Server(server, {
        cors: {
            origin: [
                "http://localhost:3000",
                "http://localhost:3001",
                process.env.NEXTAUTH_URL
            ].filter(Boolean),
            methods: ["GET", "POST"],
            credentials: true
        },
        transports: ['websocket', 'polling'],
        allowEIO3: true
    });

    log('Socket.IO server initialized with enhanced video consultation support');

    // Socket.IO connection handling for video consultations
    io.on('connection', (socket) => {
        log(`New client connected: ${socket.id}`);

        // Join video consultation room
        socket.on('join-video-room', (roomId) => {
            socket.join(roomId);
            
            if (!rooms.has(roomId)) {
                rooms.set(roomId, new Set());
                log(`Created new video consultation room: ${roomId}`);
            }
            
            rooms.get(roomId).add(socket.id);
            participants.set(socket.id, roomId);
            
            const roomSize = rooms.get(roomId).size;
            log(`Socket ${socket.id} joined video room: ${roomId} (${roomSize} participants)`);
            
            // Notify other participants in the room
            socket.to(roomId).emit('user-joined', {
                socketId: socket.id,
                roomId: roomId,
                participantCount: roomSize
            });

            // Send room info to the joining user
            socket.emit('room-joined', {
                roomId: roomId,
                participantCount: roomSize,
                participants: Array.from(rooms.get(roomId))
            });
        });

        // Handle WebRTC signaling - video offer
        socket.on('video-offer', (data) => {
            const { roomId, offer, targetSocketId } = data;
            log(`Video offer from ${socket.id} to ${targetSocketId} in room ${roomId}`);
            
            if (targetSocketId) {
                socket.to(targetSocketId).emit('video-offer', {
                    offer,
                    fromSocketId: socket.id,
                    roomId
                });
            } else {
                // Broadcast to all other participants in the room
                socket.to(roomId).emit('video-offer', {
                    offer,
                    fromSocketId: socket.id,
                    roomId
                });
            }
        });

        // Handle WebRTC signaling - video answer
        socket.on('video-answer', (data) => {
            const { answer, targetSocketId, roomId } = data;
            log(`Video answer from ${socket.id} to ${targetSocketId}`);
            
            socket.to(targetSocketId).emit('video-answer', {
                answer,
                fromSocketId: socket.id,
                roomId
            });
        });

        // Handle ICE candidates for WebRTC connection
        socket.on('ice-candidate', (data) => {
            const { candidate, targetSocketId, roomId } = data;
            
            if (targetSocketId) {
                socket.to(targetSocketId).emit('ice-candidate', {
                    candidate,
                    fromSocketId: socket.id,
                    roomId
                });
            } else {
                // Broadcast to room if no specific target
                const userRoom = participants.get(socket.id);
                if (userRoom) {
                    socket.to(userRoom).emit('ice-candidate', {
                        candidate,
                        fromSocketId: socket.id,
                        roomId: userRoom
                    });
                }
            }
        });

        // Handle media state changes (mute/unmute, camera on/off)
        socket.on('media-state-change', (data) => {
            const { roomId, mediaState } = data;
            const userRoom = participants.get(socket.id) || roomId;
            
            if (userRoom) {
                socket.to(userRoom).emit('participant-media-change', {
                    socketId: socket.id,
                    mediaState,
                    roomId: userRoom
                });
                log(`Media state change for ${socket.id} in room ${userRoom}:`, mediaState);
            }
        });

        // Leave video consultation room
        socket.on('leave-video-room', () => {
            const roomId = participants.get(socket.id);
            if (roomId && rooms.has(roomId)) {
                rooms.get(roomId).delete(socket.id);
                const remainingParticipants = rooms.get(roomId).size;
                
                socket.to(roomId).emit('user-left', {
                    socketId: socket.id,
                    roomId,
                    participantCount: remainingParticipants
                });
                
                socket.leave(roomId);
                log(`Socket ${socket.id} left video room: ${roomId} (${remainingParticipants} remaining)`);
                
                // Clean up empty rooms
                if (remainingParticipants === 0) {
                    rooms.delete(roomId);
                    log(`Deleted empty video room: ${roomId}`);
                }
            }
            participants.delete(socket.id);
        });

        // Handle chat messages in video consultation
        socket.on('consultation-chat', (data) => {
            const { roomId, message, timestamp } = data;
            const userRoom = participants.get(socket.id) || roomId;
            
            if (userRoom) {
                socket.to(userRoom).emit('consultation-chat', {
                    message,
                    fromSocketId: socket.id,
                    timestamp,
                    roomId: userRoom
                });
                log(`Chat message in room ${userRoom} from ${socket.id}`);
            }
        });

        // Handle connection quality reports
        socket.on('connection-quality', (data) => {
            const { roomId, quality } = data;
            const userRoom = participants.get(socket.id) || roomId;
            
            if (userRoom) {
                socket.to(userRoom).emit('participant-quality-update', {
                    socketId: socket.id,
                    quality,
                    roomId: userRoom
                });
            }
        });

        // Handle emergency notifications during consultation
        socket.on('consultation-emergency', (data) => {
            const { roomId, emergency } = data;
            const userRoom = participants.get(socket.id) || roomId;
            
            if (userRoom) {
                io.to(userRoom).emit('consultation-emergency', {
                    emergency,
                    fromSocketId: socket.id,
                    timestamp: new Date().toISOString(),
                    roomId: userRoom
                });
                log(`EMERGENCY in video consultation room ${userRoom}:`, emergency);
            }
        });

        // Handle disconnection cleanup
        socket.on('disconnect', (reason) => {
            const roomId = participants.get(socket.id);
            if (roomId && rooms.has(roomId)) {
                rooms.get(roomId).delete(socket.id);
                const remainingParticipants = rooms.get(roomId).size;
                
                socket.to(roomId).emit('user-left', {
                    socketId: socket.id,
                    roomId,
                    participantCount: remainingParticipants,
                    reason: 'disconnect'
                });
                
                // Clean up empty rooms
                if (remainingParticipants === 0) {
                    rooms.delete(roomId);
                    log(`Deleted empty video room after disconnect: ${roomId}`);
                }
            }
            participants.delete(socket.id);
            log(`Client disconnected: ${socket.id} (reason: ${reason})`);
        });

        // Heartbeat for connection monitoring
        socket.on('ping', () => {
            socket.emit('pong');
        });
    });

    // Start the server
    server.listen(port, (err) => {
        if (err) throw err;
        console.log( Aarogya Sahayak server ready on http://:);
        console.log( Video consultation server initialized);
        console.log( Telemedicine features activated);
        console.log( Environment: );
    });
}).catch((ex) => {
    console.error('Error starting Aarogya Sahayak server:', ex.stack);
    process.exit(1);
});
